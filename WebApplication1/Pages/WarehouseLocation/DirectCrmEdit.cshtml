@page
@model WebApplication1.Pages.WarehouseLocation.DirectCrmEditModel

@{
    ViewData["Title"] = "ویرایش انبار در CRM";
}

<div class="container mt-5" dir="rtl">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">ویرایش انبار در Dynamics CRM</h5>
        </div>

        <div class="card-body">
            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UpdateWarehouseLocation.Name"
                           class="form-label">نام انبار</label>

                    <input asp-for="UpdateWarehouseLocation.Name"
                           class="form-control" />

                    <span asp-validation-for="UpdateWarehouseLocation.Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UpdateWarehouseLocation.Code"
                           class="form-label">کد انبار</label>

                    <input asp-for="UpdateWarehouseLocation.Code"
                           class="form-control" />

                    <span asp-validation-for="UpdateWarehouseLocation.Code"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UpdateWarehouseLocation.Owner"
                           class="form-label">مالک انبار</label>

                    <input asp-for="UpdateWarehouseLocation.Owner"
                           class="form-control" />

                    <span asp-validation-for="UpdateWarehouseLocation.Owner"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    ذخیره تغییرات
                </button>

                <a asp-page="/WarehouseLocation/Index"
                   class="btn btn-secondary">
                    بازگشت
                </a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
