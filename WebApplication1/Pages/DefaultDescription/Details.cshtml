@page "{id:int}"
@model WebApplication1.Pages.DefaultDescription.DetailsModel

<h2>جزئیات شرح پیش‌فرض</h2>

@if (Model.Item != null)
{
    <dl class="row">
        <dt class="col-sm-2">شناسه</dt>
        <dd class="col-sm-10">@Model.Item.Id</dd>

        <dt class="col-sm-2">مالک</dt>
        <dd class="col-sm-10">@Model.Item.Owner</dd>

        <dt class="col-sm-2">نام</dt>
        <dd class="col-sm-10">@Model.Item.Name</dd>

        <dt class="col-sm-2">کد</dt>
        <dd class="col-sm-10">@Model.Item.Code</dd>
    </dl>
}

<a asp-page="/DefaultDescription/Edit"
   asp-route-id="@Model.Item?.Id"
   class="btn btn-warning">ویرایش</a>

<a asp-page="/DefaultDescription/Index" class="btn btn-secondary">
    بازگشت به لیست
</a>
